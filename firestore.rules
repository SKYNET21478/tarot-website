rules_version = '2';

// 타로운세 후기 게시판 보안 규칙이에요.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 게시된 내용과 같아요.
// 단, 관리자 이메일은 이 파일에 적지 않았어요. (이 파일은 공개 저장소에 올라가요)
// 콘솔에 붙여 넣을 때 ADMIN_EMAIL 자리에 실제 관리자 Google 계정 주소를 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: Google 로그인으로 확인된 관리자 계정 한 개뿐이에요.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL'
        && request.auth.token.email_verified == true;
    }

    // 등록을 막는 표현들이에요. reviews.js 의 BLOCKED_WORDS 와 같은 목록이에요. (고칠 때 함께 고쳐요)
    function hasBlockedWord(value) {
      return value.matches('(?is).*(시발|씨발|씨바|씨팔|ㅅㅂ|ㅆㅂ|병신|ㅂㅅ|지랄|ㅈㄹ|좆|존나|ㅈㄴ|개새|새끼|ㅅㄲ|썅|쌍년|쌍놈|미친놈|미친년|염병|엿먹|닥쳐|꺼져|느금|니애미|창녀|섹스|야동|포르노|자위|성인용품|성인사이트|성인방송|조건만남|원나잇|카지노|바카라|토토|도박|대출|fuck|shit|bitch|asshole|porn|sex|casino|https?://|www[.]).*');
    }

    match /reviews/{reviewId} {
      // 승인된(approved == true) 후기는 누구나, 나머지는 관리자만 읽을 수 있어요.
      allow read: if resource.data.approved == true || isAdmin();

      // 누구나 후기를 쓸 수 있지만, 정해진 모양과 길이만 받고 항상 "미승인"으로 저장돼요.
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 500
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time
        && !hasBlockedWord(request.resource.data.name)
        && !hasBlockedWord(request.resource.data.text);

      // 관리자는 승인 여부(approved)만 바꿀 수 있어요. 글 내용은 관리자도 못 고쳐요.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;

      // 삭제는 관리자만 할 수 있어요.
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      // 공지사항: visible == true 인 글은 누구나, 숨긴 글은 관리자만 읽을 수 있어요.
      allow read: if resource.data.visible == true || isAdmin();

      // 쓰기·수정은 관리자만, 정해진 모양과 길이로만 할 수 있어요.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'text', 'visible', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.visible is bool;

      // 삭제는 관리자만 할 수 있어요.
      allow delete: if isAdmin();
    }

    // 그 밖의 모든 문서는 읽기·쓰기를 막아요.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
