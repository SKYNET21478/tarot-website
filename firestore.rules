rules_version = '2';

// 타로운세 후기 게시판 보안 규칙이에요.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여 넣고 "게시"를 눌러요.
service cloud.firestore {
  match /databases/{database}/documents {

    match /reviews/{reviewId} {
      // 승인된(approved == true) 후기만 누구나 읽을 수 있어요.
      allow read: if resource.data.approved == true;

      // 누구나 후기를 쓸 수 있지만, 정해진 모양과 길이만 받고 항상 "미승인"으로 저장돼요.
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 500
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;

      // 수정과 삭제는 웹에서는 아무도 못 해요. (승인·삭제는 Firebase 콘솔에서 직접 해요)
      allow update, delete: if false;
    }

    match /notices/{noticeId} {
      // 공지사항: visible == true 인 글만 누구나 읽을 수 있어요.
      // 쓰기·수정·삭제는 웹에서는 아무도 못 하고, Firebase 콘솔에서만 해요.
      allow read: if resource.data.visible == true;
      allow write: if false;
    }

    // 그 밖의 모든 문서는 읽기·쓰기를 막아요.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
